# Copy to backend/.env (git-ignored) and change what you need, then run
# `docker compose up -d` again. Every value here is the default, so an empty
# or missing .env behaves the same. See README.md for what each one does.

# Host port the API is published on. The container always listens on 8080.
SUDS_HOST_PORT=8080

# Shared secret. If set, requests (except /health) need the header
# X-Suds-Token: <value>. Empty = no auth.
SUDS_TOKEN=

# "Your slot moved" pushes via ntfy, e.g. https://ntfy.sh. Empty = off.
NTFY_URL=
# Topics are <prefix>-<person>, e.g. suds-ruby. Pick an unusual prefix on
# public ntfy.sh, since anyone who guesses a topic can read it.
NTFY_TOPIC_PREFIX=suds

# Each notification's JSON is also POSTed here when set. Empty = off.
WEBHOOK_URL=

# The household's time zone: what "today" means for Start, and the times
# written in notification messages.
TZ=Europe/London
